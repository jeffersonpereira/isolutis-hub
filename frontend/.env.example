# Endereço da API em produção quando o front e a API ficam em origens diferentes.
# Em desenvolvimento deixe em branco: o Vite faz proxy de /api para o backend.
VITE_API_URL=

# "desenvolvimento" exibe o selo "Dev" na barra superior (ver mostrarSeloDeAmbiente em main.ts).
# Não precisa definir localmente: `npm run dev` já mostra o selo automaticamente.
VITE_AMBIENTE=
