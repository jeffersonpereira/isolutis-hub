# Copie para backend/.env (ou defina no ambiente). Todas as variáveis têm o prefixo HUB_.

# desenvolvimento | producao | teste (em produção a documentação /api/docs é desligada e a chave é validada)
HUB_AMBIENTE=desenvolvimento

# PostgreSQL 16+ (qualquer provedor; o Supabase também serve, usando a connection string do banco)
HUB_DATABASE_URL=postgresql+psycopg://hub:hub@localhost:5432/hub_dev

# Assina os tokens de login. Em produção use 32+ caracteres aleatórios:  python -c "import secrets; print(secrets.token_urlsafe(48))"
HUB_SECRET_KEY=troque-esta-chave-em-producao

# Duração da sessão em minutos (padrão 12 h)
HUB_TOKEN_MINUTOS=720

# Origens permitidas (CORS), separadas por vírgula, quando o front fica em outro endereço
HUB_CORS_ORIGINS=http://localhost:5173

# Pasta do build do frontend: se definida, a própria API entrega o site (deploy em um serviço só)
# HUB_FRONTEND_DIST=/app/static
